---
layout: layouts/base.njk
title: 申请试用 — Hive
---

<section class="ud-page-banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="ud-banner-content">
                    <h1>申请试用</h1>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ud-contact" style="padding-top: 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="ud-contact-form-wrapper wow fadeInUp" data-wow-delay=".2s">
                    <h3 class="ud-contact-form-title">填写信息，我们将在 24 小时内联系您</h3>
                    <form class="ud-contact-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="ud-form-group">
                                    <label>姓名 *</label>
                                    <input type="text" placeholder="您的姓名" required/>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ud-form-group">
                                    <label>手机 *</label>
                                    <input type="tel" placeholder="您的手机号码" required/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="ud-form-group">
                                    <label>公司 *</label>
                                    <input type="text" placeholder="公司名称" required/>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ud-form-group">
                                    <label>职位</label>
                                    <input type="text" placeholder="您的职位"/>
                                </div>
                            </div>
                        </div>
                        <div class="ud-form-group">
                            <label>邮箱</label>
                            <input type="email" placeholder="工作邮箱"/>
                        </div>
                        <div class="ud-form-group">
                            <label>当前研发团队规模</label>
                            <input type="text" placeholder="例如：5人 / 10人 / 20人以上"/>
                        </div>
                        <div class="ud-form-group">
                            <label>您最关心的问题</label>
                            <textarea rows="4" placeholder="例如：想了解如何提升团队产能 / 对 AI 质量把控有疑虑 / 想看产品 demo..."></textarea>
                        </div>
                        <div class="ud-form-group mb-0">
                            <button type="submit" class="ud-main-btn" style="width: 100%;">
                                提交申请
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
